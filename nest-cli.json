{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "config/bootstrap.yaml",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "config/bootstrap-development.yaml",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "config/bootstrap-production.yaml",
        "outDir": "dist",
        "watchAssets": true
      }
      
    ]
  }
}
